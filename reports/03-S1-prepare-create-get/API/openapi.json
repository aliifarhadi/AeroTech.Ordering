  "components": {
    "schemas": {
      "AcceptanceAssurance": {
        "enum": [
          "OwnerBound",
          "LocalCandidateOnly"
        ],
        "type": "string"
      },
      "ApiErrorItem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BackofficeCreateOrderRequest": {
        "required": [
          "acceptedAt",
          "acceptedSnapshotDigest",
          "contacts",
          "financialCustomerId",
          "preparationId",
          "sellingOfficeId",
          "travelerBindings"
        ],
        "type": "object",
        "properties": {
          "preparationId": {
            "type": "integer",
            "format": "int64"
          },
          "acceptedSnapshotDigest": {
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "travelerBindings": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TravelerBindingRequest"
            }
          },
          "contacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactRequest"
            }
          },
          "clientReference": {
            "type": "string",
            "nullable": true
          },
          "financialCustomerId": {
            "type": "integer",
            "format": "int64"
          },
          "sellingOfficeId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "BackofficePrepareOrderRequest": {
        "required": [
          "financialCustomerId",
          "offerId",
          "sellingOfficeId"
        ],
        "type": "object",
        "properties": {
          "offerId": {
            "minLength": 1,
            "type": "string"
          },
          "clientReference": {
            "type": "string",
            "nullable": true
          },
          "financialCustomerId": {
            "type": "integer",
            "format": "int64"
          },
          "sellingOfficeId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "ContactRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/ContactRole"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ContactRole": {
        "enum": [
          "Primary",
          "Emergency",
          "Agency",
          "Traveler",
          "Other"
        ],
        "type": "string"
      },
      "CreateOrderRequest": {
        "required": [
          "acceptedAt",
          "acceptedSnapshotDigest",
          "contacts",
          "preparationId",
          "travelerBindings"
        ],
        "type": "object",
        "properties": {
          "preparationId": {
            "type": "integer",
            "format": "int64"
          },
          "acceptedSnapshotDigest": {
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "travelerBindings": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TravelerBindingRequest"
            }
          },
          "contacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactRequest"
            }
          },
          "clientReference": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatedOrderResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "operationId": {
            "type": "integer",
            "format": "int64"
          },
          "orderReference": {
            "type": "string",
            "nullable": true
          },
          "commercialVersionAtCommit": {
            "type": "integer",
            "format": "int32"
          },
          "orderRevisionAtCommit": {
            "type": "integer",
            "format": "int64"
          },
          "acceptedSourceDigest": {
            "type": "string",
            "nullable": true
