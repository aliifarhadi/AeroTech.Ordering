{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preparationId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "acceptedSnapshotDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    },
    "financialCustomerId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "travelerBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceTravellerRef": {
            "type": "string",
            "minLength": 1
          },
          "clientTravelerRef": {
            "type": "string",
            "minLength": 1
          },
          "givenName": {
            "type": "string",
            "minLength": 1
          },
          "surname": {
            "type": "string",
            "minLength": 1
          },
          "passengerTypeCode": {
            "type": "string",
            "minLength": 1
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "guardianClientTravelerRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sourceTravellerRef",
          "clientTravelerRef",
          "givenName",
          "surname",
          "passengerTypeCode",
          "dateOfBirth",
          "guardianClientTravelerRef"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "role",
          "email",
          "phone"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "clientReference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "preparationId",
    "acceptedSnapshotDigest",
    "acceptedAt",
    "travelerBindings",
    "contacts"
  ],
  "additionalProperties": false
}
