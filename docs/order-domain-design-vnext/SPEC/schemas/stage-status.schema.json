{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stage": {
      "enum": [
        "D0",
        "B0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S7",
        "S8",
        "S9",
        "S10",
        "S11",
        "S12",
        "S13",
        "S14",
        "S15",
        "S16"
      ]
    },
    "executionStatus": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "FAILED",
        "BLOCKED_ENVIRONMENT",
        "BLOCKED_DECISION",
        "COMPLETED"
      ]
    },
    "localGate": {
      "enum": [
        "NOT_EVALUATED",
        "D0_CONFORMANT",
        "LOCAL_DONE",
        "FAILED"
      ]
    },
    "testedSourceCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "providerBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "Reference",
              "LiveCandidateSandbox",
              "Live"
            ]
          },
          "certification": {
            "enum": [
              "NOT_EVALUATED",
              "LIVE_CANDIDATE_PROVEN",
              "LIVE_CERTIFIED",
              "BLOCKED"
            ]
          },
          "evidenceRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "owner",
          "profile",
          "mode",
          "certification",
          "evidenceRef",
          "blockers"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "scenarioResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP",
              "NOT_RUN"
            ]
          },
          "testName": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "scenarioId",
          "result",
          "testName",
          "evidenceRef"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reproductionCommand": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "releaseCertified": {
      "type": "boolean"
    }
  },
  "required": [
    "stage",
    "executionStatus",
    "localGate",
    "testedSourceCommit",
    "evidenceCommit",
    "providerBindings",
    "scenarioResults",
    "reproductionCommand",
    "blockers",
    "releaseCertified"
  ],
  "additionalProperties": false
}
