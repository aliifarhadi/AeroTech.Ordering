{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "2.0"
    },
    "externalOperationId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "operationKey": {
      "type": "string",
      "minLength": 1
    },
    "providerProfileId": {
      "type": "string",
      "minLength": 1
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outcome": {
      "enum": [
        "Confirmed",
        "Rejected",
        "Pending",
        "Unknown"
      ]
    },
    "effectRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "targetResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetRef": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "Confirmed",
              "Rejected",
              "Pending",
              "Unknown"
            ]
          },
          "resourceRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "resourceState": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmedQuantity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceVersion": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "targetRef",
          "outcome",
          "resourceRef",
          "resourceState",
          "confirmedQuantity",
          "sourceVersion",
          "reasonCode"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "Confirmed"
                }
              }
            },
            "then": {
              "properties": {
                "resourceRef": {
                  "type": "string",
                  "minLength": 1
                },
                "resourceState": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "resourceRef",
                "resourceState",
                "sourceVersion"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "sourceRevision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "occurredAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "hasUnknown": {
      "type": "boolean"
    }
  },
  "required": [
    "contractVersion",
    "externalOperationId",
    "operationKey",
    "providerProfileId",
    "requestHash",
    "outcome",
    "effectRef",
    "targetResults",
    "sourceRevision",
    "occurredAt",
    "observedAt",
    "evidenceRef",
    "evidenceHash",
    "reasons",
    "hasUnknown"
  ],
  "additionalProperties": false
}

